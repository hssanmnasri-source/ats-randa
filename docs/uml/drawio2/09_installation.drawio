        <mxCell id="81" value="Répond aux requêtes des utilisateurs&#xa;(gestion des profils, offres, candidatures, entretiens…)&#xa;Développé avec Python / FastAPI" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="8">
