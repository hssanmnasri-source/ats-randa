        </mxCell>
        <mxCell id="121" value="Stocke les traitements en attente&#xa;(analyse de CV, calcul de scores)&#xa;et les distribue au moteur d'analyse&#xa;(Redis)" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="12">
