        <mxCell id="111" value="Stocke toutes les données : utilisateurs,&#xa;candidats, CV, offres, résultats, entretiens…&#xa;(PostgreSQL)" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="11">
