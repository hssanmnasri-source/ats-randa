        <mxCell id="71" value="Reçoit toutes les requêtes du navigateur / de l'app&#xa;et les redirige vers le bon service interne" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="7">
