        <mxCell id="131" value="Surveille la performance du système en temps réel&#xa;(temps de réponse, erreurs, charge du serveur)&#xa;(Grafana + Prometheus)" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="13">
