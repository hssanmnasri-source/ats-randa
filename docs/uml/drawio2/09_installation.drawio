        </mxCell>
        <mxCell id="91" value="Analyse les CV et calcule les scores&#xa;en arrière-plan, sans bloquer le serveur&#xa;(Celery Worker)" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="9">
