<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">

  <!-- PAGE 1 — Démarrage de l'app mobile -->
  <diagram id="demarrage_mobile" name="10a — Démarrage de l'application mobile">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="2" value="Comment l'application mobile démarre et reconnecte l'utilisateur automatiquement" style="text;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="10" width="900" height="25" as="geometry"/>
        </mxCell>

        <!-- PARTICIPANTS -->
        <mxCell id="10" value="Application&#xa;mobile" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="45" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="11" value="Mémoire sécurisée&#xa;du téléphone" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="45" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="12" value="Serveur" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="45" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="13" value="Écran&#xa;(affichage)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="45" width="110" height="40" as="geometry"/></mxCell>

        <!-- LIFELINES -->
        <mxCell id="20" value="" style="endArrow=none;dashed=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="85" as="sourcePoint"/><mxPoint x="85" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="21" value="" style="endArrow=none;dashed=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="85" as="sourcePoint"/><mxPoint x="260" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="22" value="" style="endArrow=none;dashed=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="85" as="sourcePoint"/><mxPoint x="435" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="23" value="" style="endArrow=none;dashed=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="85" as="sourcePoint"/><mxPoint x="615" y="700" as="targetPoint"/></mxGeometry></mxCell>

        <!-- MESSAGES -->
        <mxCell id="30" value="L'utilisateur ouvre l'application" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="115" as="sourcePoint"/><mxPoint x="85" y="115" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="31" value="Vérifie si un jeton de connexion est sauvegardé" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="150" as="sourcePoint"/><mxPoint x="260" y="150" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ALT : jeton trouvé -->
        <mxCell id="32" value="Un jeton de connexion existe" style="swimlane;fontStyle=1;startSize=22;fillColor=none;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="170" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Renvoie le jeton enregistré" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="32"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="35" as="sourcePoint"/><mxPoint x="0" y="35" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="34" value="Demande le profil au serveur avec le jeton" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="32"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="70" as="sourcePoint"/><mxPoint x="350" y="70" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="35" value="Renvoie le profil et le rôle de l'utilisateur" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="32"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="105" as="sourcePoint"/><mxPoint x="0" y="105" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="36" value="Ouvre directement l'espace correspondant au rôle" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="32"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="140" as="sourcePoint"/><mxPoint x="530" y="140" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="37" value="Affiche le tableau de bord (RH ou Candidat)" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="32"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="170" as="sourcePoint"/><mxPoint x="0" y="170" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ALT : pas de jeton -->
        <mxCell id="38" value="Aucun jeton sauvegardé (première utilisation ou déconnexion)" style="swimlane;fontStyle=1;startSize=22;fillColor=none;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="385" width="620" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="39" value="Affiche l'écran de connexion" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="38"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="45" as="sourcePoint"/><mxPoint x="530" y="45" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="40" value="NOTE : Le jeton de connexion est conservé de façon sécurisée sur le téléphone.&#xa;À l'ouverture de l'application, la reconnexion est automatique sans avoir à se reconnecter." style="text;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=8;rounded=1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="490" width="620" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 2 — Navigation selon le rôle -->
  <diagram id="navigation_mobile" name="10b — Navigation selon le rôle">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="2" value="Navigation dans l'application selon le rôle (RH ou Candidat)" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="700" height="25" as="geometry"/>
        </mxCell>

        <!-- ÉCRAN D'ACCUEIL -->
        <mxCell id="10" value="Écran de connexion" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- DÉCISION RÔLE -->
        <mxCell id="11" value="Quel est le rôle de l'utilisateur ?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="385" y="140" width="230" height="70" as="geometry"/>
        </mxCell>

        <!-- ESPACE RH -->
        <mxCell id="20" value="Espace RH" style="swimlane;fontStyle=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="380" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="Tableau de bord&#xa;(statistiques et activité récente)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="20"><mxGeometry x="15" y="38" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="22" value="Offres d'emploi&#xa;(liste, détail, lancement de la sélection)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="20"><mxGeometry x="15" y="108" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="23" value="CVthèque&#xa;(tous les candidats et leurs CV)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="20"><mxGeometry x="15" y="178" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="24" value="Calendrier&#xa;(entretiens planifiés)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="20"><mxGeometry x="15" y="248" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="25" value="(Onglets du bas de l'écran : 4 sections)" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=3;" vertex="1" parent="20"><mxGeometry x="15" y="400" width="350" height="25" as="geometry"/></mxCell>

        <!-- ESPACE CANDIDAT -->
        <mxCell id="30" value="Espace candidat" style="swimlane;fontStyle=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="260" width="380" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Accueil&#xa;(résumé du profil et dernières actualités)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="30"><mxGeometry x="15" y="38" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="32" value="Offres d'emploi&#xa;(recherche et détail des offres disponibles)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="30"><mxGeometry x="15" y="108" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="33" value="Mes candidatures&#xa;(suivi des 4 étapes et décisions RH)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="30"><mxGeometry x="15" y="178" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="34" value="Mon profil&#xa;(informations personnelles, CV, lettres)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="30"><mxGeometry x="15" y="248" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="35" value="(Onglets du bas de l'écran : 4 sections)" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=3;" vertex="1" parent="30"><mxGeometry x="15" y="400" width="350" height="25" as="geometry"/></mxCell>

        <!-- TRANSITIONS -->
        <mxCell id="t1" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" value="RH" style="endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="20">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="230"/><mxPoint x="230" y="230"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="t3" value="Candidat" style="endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="30">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="230"/><mxPoint x="760" y="230"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="50" value="L'application détecte automatiquement le rôle après la connexion&#xa;et affiche l'espace adapté. Un changement de rôle nécessite une déconnexion." style="text;strokeColor=none;fillColor=#fff2cc;align=center;rounded=1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="730" width="690" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
