        <mxCell id="48" value="Transmet l'identité de l'utilisateur à la logique métier" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="415" as="sourcePoint"/><mxPoint x="375" y="415" as="targetPoint"/></mxGeometry></mxCell>
