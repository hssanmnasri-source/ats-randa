        <mxCell id="41" value="Renvoie le contenu du jeton (identifiant + rôle de l'utilisateur)" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="165" as="sourcePoint"/><mxPoint x="560" y="165" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="42" value="Recherche le compte dans la base avec l'identifiant" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="200" as="sourcePoint"/><mxPoint x="960" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="43" value="Renvoie les informations du compte" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="235" as="sourcePoint"/><mxPoint x="560" y="235" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="44" value="Vérifie que le rôle donne accès à cette page" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="270" as="sourcePoint"/><mxPoint x="680" y="270" as="targetPoint"/></mxGeometry></mxCell>

