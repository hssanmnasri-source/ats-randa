        <mxCell id="60" value="Ce mécanisme est appliqué automatiquement à chaque action.&#xa;L'utilisateur ne le voit pas : s'il est connecté, tout fonctionne normalement." style="text;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=8;rounded=1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
