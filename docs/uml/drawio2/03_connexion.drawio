        <mxCell id="46" value="Renvoie : accès interdit (mauvais rôle)" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="330" as="sourcePoint"/><mxPoint x="0" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="46b" value="Affiche un message « Accès non autorisé »" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="360" as="sourcePoint"/><mxPoint x="0" y="360" as="targetPoint"/></mxGeometry></mxCell>

