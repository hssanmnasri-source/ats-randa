        <!-- MESSAGES -->
        <mxCell id="30" value="Demande une page protégée (ex : liste des offres RH)&#xa;en joignant son jeton de connexion" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="135" as="sourcePoint"/><mxPoint x="275" y="135" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="31" value="Transfère la demande avec le jeton" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="175" as="sourcePoint"/><mxPoint x="460" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="32" value="Extrait le jeton et demande sa vérification" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="210" as="sourcePoint"/><mxPoint x="645" y="210" as="targetPoint"/></mxGeometry></mxCell>
