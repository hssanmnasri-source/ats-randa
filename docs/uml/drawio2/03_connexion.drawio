        <mxCell id="37" value="Renvoie : jeton non reconnu" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="50" as="sourcePoint"/><mxPoint x="560" y="50" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="38" value="Renvoie : accès refusé (non connecté)" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="35"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="80" as="sourcePoint"/><mxPoint x="0" y="80" as="targetPoint"/></mxGeometry></mxCell>
