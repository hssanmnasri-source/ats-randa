<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">

  <!-- PAGE 1 — Cycle de vie d'un CV -->
  <diagram id="etats_cv" name="07a — Cycle de vie d'un CV">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="Cycle de vie d'un CV dans le système" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Initial -->
        <mxCell id="3" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="490" y="55" width="28" height="28" as="geometry"/>
        </mxCell>

        <!-- DÉPOSÉ -->
        <mxCell id="4" value="Déposé" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="130" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="4b" value="Le fichier est enregistré sur le serveur&#xa;et attend d'être traité." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="192" width="310" height="32" as="geometry"/>
        </mxCell>

        <!-- EN COURS D'ANALYSE -->
        <mxCell id="5" value="En cours d'analyse" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="275" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="5b" value="Le moteur d'analyse extrait les informations du CV&#xa;(nom, compétences, expériences, langues…)" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="337" width="330" height="32" as="geometry"/>
        </mxCell>

        <!-- INDEXÉ -->
        <mxCell id="6" value="Indexé (prêt pour la sélection)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="420" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="6b" value="L'analyse est terminée. Le CV est mis en correspondance&#xa;automatiquement avec toutes les offres d'emploi actives." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="482" width="350" height="32" as="geometry"/>
        </mxCell>

        <!-- ERREUR -->
        <mxCell id="7" value="Erreur d'analyse" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="350" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="7b" value="Le fichier est illisible ou de mauvaise qualité.&#xa;L'agent peut être notifié pour déposer un nouveau CV." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="412" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- Final -->
        <mxCell id="8" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="484" y="560" width="36" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="8b" value="(Le CV reste en base et continue de participer aux sélections futures)" style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="350" height="24" as="geometry"/>
        </mxCell>

        <!-- TRANSITIONS -->
        <mxCell id="t1" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t1b" value="Fichier reçu" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="90" height="20" as="geometry"/></mxCell>

        <mxCell id="t2" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2b" value="Traitement automatique déclenché" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="228" width="90" height="36" as="geometry"/></mxCell>

        <mxCell id="t3" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3b" value="Analyse réussie" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="90" height="20" as="geometry"/></mxCell>

        <mxCell id="t4" value="" style="endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4b" value="Fichier illisible" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="318" width="80" height="20" as="geometry"/></mxCell>

        <mxCell id="t5" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="6" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t5b" value="En correspondance active" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="524" width="90" height="30" as="geometry"/></mxCell>

        <!-- RE-ANALYSE -->
        <mxCell id="t6" value="Nouveau dépôt → ré-analyse automatique" style="endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="6" target="4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="450"/><mxPoint x="310" y="160"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 2 — Décision RH sur une candidature -->
  <diagram id="etats_decision" name="07b — Décision sur une candidature">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="États d'une candidature vue du responsable RH" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Début -->
        <mxCell id="3" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="490" y="55" width="28" height="28" as="geometry"/>
        </mxCell>

        <!-- EN ATTENTE -->
        <mxCell id="4" value="En attente" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="130" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="4b" value="Le score a été calculé automatiquement.&#xa;Le RH n'a pas encore rendu de décision." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="194" width="310" height="30" as="geometry"/>
        </mxCell>

        <!-- RETENU -->
        <mxCell id="5" value="Retenu(e)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="5b" value="Le RH a décidé de retenir ce candidat.&#xa;Un entretien peut être planifié." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="394" width="320" height="30" as="geometry"/>
        </mxCell>

        <!-- REFUSÉ -->
        <mxCell id="6" value="Non retenu(e)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="330" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="6b" value="Le RH a décidé de ne pas retenir ce candidat.&#xa;Un email de notification peut lui être envoyé." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="394" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- ENTRETIEN PLANIFIÉ -->
        <mxCell id="7" value="Entretien planifié" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="520" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="7b" value="Un créneau d'entretien a été proposé&#xa;et envoyé par email au candidat." style="text;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="584" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- TRANSITIONS -->
        <mxCell id="t1" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t1b" value="Score calculé automatiquement" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="92" width="100" height="30" as="geometry"/></mxCell>

        <mxCell id="t2" value="" style="endArrow=block;endFill=1;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2b" value="RH retient&#xa;le candidat" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="260" width="90" height="30" as="geometry"/></mxCell>

        <mxCell id="t3" value="" style="endArrow=block;endFill=1;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3b" value="RH refuse&#xa;le candidat" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="90" height="30" as="geometry"/></mxCell>

        <mxCell id="t4" value="" style="endArrow=block;endFill=1;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4b" value="Entretien généré" style="text;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="470" width="100" height="20" as="geometry"/></mxCell>

        <!-- Note immuabilité -->
        <mxCell id="9" value="⚠ Important : une fois « Retenu(e) » ou « Non retenu(e) », la décision est définitive.&#xa;Le système ne peut pas l'écraser, même lors d'un nouveau calcul automatique." style="text;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=8;rounded=1;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="660" width="740" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
