  <diagram id="activites_recrutement" name="08 — Activités Recrutement">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="Processus complet de recrutement (bout en bout)" style="text;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ═══ SWIMLANES ═══ -->
        <!-- Agent de saisie -->
        <mxCell id="3" value="Agent de saisie" style="swimlane;fontStyle=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="10" y="50" width="300" height="750" as="geometry"/>
        </mxCell>
        <!-- Système NLP -->
        <mxCell id="4" value="Système NLP — Celery Worker" style="swimlane;fontStyle=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="300" height="750" as="geometry"/>
        </mxCell>
        <!-- Responsable RH -->
        <mxCell id="5" value="Responsable RH" style="swimlane;fontStyle=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d6b656;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="50" width="280" height="750" as="geometry"/>
        </mxCell>
        <!-- n8n + Mailer -->
        <mxCell id="6" value="n8n + Mailer" style="swimlane;fontStyle=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="50" width="260" height="750" as="geometry"/>
        </mxCell>
        <!-- Candidat -->
        <mxCell id="7" value="Candidat" style="swimlane;fontStyle=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="1190" y="50" width="260" height="750" as="geometry"/>
        </mxCell>

        <!-- ═══ AGENT LANE — Activities ═══ -->
        <!-- Start -->
        <mxCell id="10" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="3">
          <mxGeometry x="115" y="30" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Reçoit PDF CV candidat" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="3">
          <mxGeometry x="50" y="90" width="200" height="50" as="geometry"/>
        </mxCell>
        <!-- Decision: Format Keejob? -->
        <mxCell id="12" value="Format Keejob ?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="3">
          <mxGeometry x="75" y="170" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="POST /api/agent/import/keejob&#xa;(parsing synchrone)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="3">
          <mxGeometry x="50" y="270" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="POST /api/agent/cvs/upload&#xa;(OCR + Celery async)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="3">
          <mxGeometry x="50" y="360" width="200" height="50" as="geometry"/>
        </mxCell>
        <!-- Decision: Score OCR? -->
        <mxCell id="15" value="Score OCR ≥ 40 ?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="3">
          <mxGeometry x="75" y="440" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="Alerte qualité insuffisante&#xa;(conseils affichés)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="3">
          <mxGeometry x="50" y="530" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- ═══ NLP LANE — Activities ═══ -->
        <mxCell id="20" value="Tâche process_cv_on_upload(cv_id)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="90" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="extract_text_from_pdf()&#xa;(pdfplumber ou Tesseract fra+eng+ara)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="170" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="parse_keejob_cv()&#xa;OU parse_generic_cv()" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="250" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="cv_to_embed_text(cv_entities, cv_text)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="330" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="encode(text) → Vector(384)&#xa;(paraphrase-multilingual-MiniLM-L12-v2)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="410" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="25" value="UPDATE cv.statut=INDEXED&#xa;cv.embedding=vector&#xa;cv.cv_version+=1" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="490" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="26" value="SELECT job_offers&#xa;WHERE statut=ACTIVE" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="580" width="200" height="50" as="geometry"/>
        </mxCell>
        <!-- Loop: pour chaque offre -->
        <mxCell id="27" value="compute_final_score(&#xa;cosine_sim, jaccard, exp, langue)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="4">
          <mxGeometry x="50" y="660" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- ═══ RH LANE — Activities ═══ -->
        <mxCell id="30" value="Crée offre d'emploi&#xa;POST /api/rh/offers&#xa;(statut: BROUILLON)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="90" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Configure pondérations&#xa;PUT .../poids&#xa;(40%+35%+15%+10%=1.0)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="180" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="Publie offre&#xa;PATCH .../statut → ACTIVE" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="270" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Lance matching&#xa;POST .../matching?top_n=50" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="350" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="pgvector KNN top 200 CVs" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="430" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="scorer.py → top 50 par score_final" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="5">
          <mxGeometry x="40" y="510" width="200" height="50" as="geometry"/>
        </mxCell>
