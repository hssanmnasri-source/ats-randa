          <mxGeometry x="10" y="680" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="PATCH → REFUSED&#xa;+ feedback optionnel" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="5">
