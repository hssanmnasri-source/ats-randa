                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 01_Classes_ATS_RANDA\nskinparam classAttributeIconSize 0\nskinparam classFontSize 11\nskinparam classFontName Arial\nskinparam classBackgroundColor #FEFECE\nskinparam classBorderColor #A80036\nskinparam arrowColor #A80036\nskinparam packageBackgroundColor #EEEEEE\nhide empty methods\n\n&#39; ===================================================\n&#39; BASE — TABLE users (discriminée par role)\n&#39; ===================================================\nabstract class Utilisateur {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom : String\n  +prenom : String\n  +email : String &lt;&lt;UNIQUE&gt;&gt;\n  +hashed_pwd : String\n  +role : UserRole\n  +departement : String\n  +id_filiale : Integer &lt;&lt;FK&gt;&gt;\n  +is_active : Boolean\n  +google_id : String &lt;&lt;UNIQUE&gt;&gt;\n  +auth_provider : String\n  +avatar_url : Text\n}\n\n&#39; ===================================================\n&#39; ROLES — spécialisations de Utilisateur\n&#39; ===================================================\nclass Admin &lt;&lt;role&gt;&gt; {\n  &#39; accès total : users, stats, audit, system\n}\n\nclass RH &lt;&lt;role&gt;&gt; {\n  &#39; gère offres, matching, entretiens\n}\n\nclass Agent &lt;&lt;role&gt;&gt; {\n  &#39; importe et gère les CVs\n}\n\nclass CandidatUser &lt;&lt;role&gt;&gt; {\n  &#39; compte candidat côté auth\n}\n\nUtilisateur &lt;|-- Admin\nUtilisateur &lt;|-- RH\nUtilisateur &lt;|-- Agent\nUtilisateur &lt;|-- CandidatUser\n\n&#39; ===================================================\n&#39; FILIALE\n&#39; ===================================================\nclass Filiale {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom_filiale : String\n  +adresse : Text\n  +ville : String\n  +created_at : DateTime\n}\n\nFiliale \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Utilisateur : id_filiale\n\n&#39; ===================================================\n&#39; CANDIDATE — profil métier du candidat\n&#39; ===================================================\nclass Candidate {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom : String\n  +prenom : String\n  +email : String &lt;&lt;UNIQUE&gt;&gt;\n  +telephone : String\n  +titre_poste : String\n  +niveau_experience : String\n  +niveau_etude : String\n  +visibility_status : VisibilityStatus\n  +secteurs_recherche : JSONB\n  +metiers_recherche : JSONB\n  +mobilite_tn : Boolean\n  +mobilite_intl : Boolean\n}\n\nCandidatUser \&quot;1\&quot; ..&gt; \&quot;1\&quot; Candidate : résolu par email\n\n&#39; ===================================================\n&#39; CV\n&#39; ===================================================\nclass CV {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +id_agent : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +statut : CVStatus\n  +source : CVSource\n  +fichier_pdf : String\n  +cv_text : Text\n  +cv_entities : JSONB\n  +embedding : Vector(384)\n  +score_final : Float\n  +cv_version : Integer\n}\n\nclass Competence {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +nom_competence : String\n  +niveau : SkillLevel\n}\n\nclass Experience {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +poste : String\n  +entreprise : String\n  +date_debut : String\n  +date_fin : String\n  +description : Text\n  +type_contrat : String\n  +is_current : Boolean\n}\n\nCandidate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CV         : id_candidate\nAgent     \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CV         : id_agent (import)\nCV        \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Competence : id_cv\nCV        \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Experience : id_cv\n\n&#39; ===================================================\n&#39; JOB OFFER\n&#39; ===================================================\nclass JobOffer {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_rh : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +titre : String\n  +description : Text\n  +competences_requises : JSONB\n  +experience_requise : Float\n  +langue_requise : String\n  +embedding : Vector(384)\n  +statut : OfferStatus\n  +poids_semantique : Float (0.40)\n  +poids_competences : Float (0.35)\n  +poids_experience : Float (0.15)\n  +poids_langue : Float (0.10)\n  +date_expiration : DateTime\n}\n\nRH \&quot;1\&quot; --&gt; \&quot;0..*\&quot; JobOffer : id_rh\n\n&#39; ===================================================\n&#39; RESULTAT MATCHING\n&#39; ===================================================\nclass Resultat {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +id_offre : Integer &lt;&lt;FK&gt;&gt;\n  +score_matching : Float\n  +score_skills : Float\n  +score_experience : Float\n  +score_langue : Float\n  +score_final : Float\n  +rang : Integer\n  +decision : Decision\n  +feedback_rh : Text &lt;&lt;nullable&gt;&gt;\n  +feedback_visible : Boolean\n  +date_decision : DateTime &lt;&lt;nullable&gt;&gt;\n}\n\nCV       \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Resultat : id_cv\nJobOffer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Resultat : id_offre\n\n&#39; ===================================================\n&#39; ENTRETIEN\n&#39; ===================================================\nclass Entretien {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_resultat : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +id_offre : Integer &lt;&lt;FK&gt;&gt;\n  +id_rh : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +id_candidate_user : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +date_entretien : DateTime\n  +duree_minutes : Integer\n  +lieu : String\n  +type_entretien : String\n  +lien_visio : Text\n  +statut : String\n  +email_envoye : Boolean\n  +n8n_execution_id : String\n}\n\nRH           \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Entretien : id_rh\nCandidatUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Entretien : id_candidate_user\nResultat     \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Entretien : id_resultat\nJobOffer     \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Entretien : id_offre\n\n&#39; ===================================================\n&#39; CANDIDATURE DOCUMENTS &amp; LETTRES\n&#39; ===================================================\nclass CandidateDocument {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +nom : String\n  +fichier : String\n  +type_doc : String\n  +taille : Integer\n}\n\nclass CoverLetter {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +titre : String\n  +contenu : Text\n}\n\nCandidate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CandidateDocument : id_candidate\nCandidate \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CoverLetter       : id_candidate\n\n&#39; ===================================================\n&#39; AUDIT LOG\n&#39; ===================================================\nclass AuditLog {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +user_id : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +action : String &lt;&lt;INDEX&gt;&gt;\n  +resource : String\n  +resource_id : Integer\n  +details : JSONB\n  +ip_address : String\n  +created_at : DateTime &lt;&lt;INDEX&gt;&gt;\n}\n\nUtilisateur \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog : user_id\n\n&#39; ===================================================\n&#39; ENUMS\n&#39; ===================================================\nenum UserRole {\n  VISITOR\n  CANDIDATE\n  AGENT\n  RH\n  ADMIN\n}\n\nenum CVStatus {\n  UPLOADED\n  PARSING\n  INDEXED\n  ERROR\n}\n\nenum CVSource {\n  KEEJOB\n  AGENT\n  CANDIDAT\n  EMAIL\n  LINKEDIN\n}\n\nenum OfferStatus {\n  ACTIVE\n  INACTIVE\n  ARCHIVED\n  BROUILLON\n  EN_VALIDATION\n  PROCHAINEMENT\n  DESACTIVEE\n  EXPIREE\n  REFUSEE\n}\n\nenum Decision {\n  RETAINED\n  PENDING\n  REFUSED\n}\n\nenum SkillLevel {\n  BEGINNER\n  INTERMEDIATE\n  EXPERT\n}\n\nenum VisibilityStatus {\n  PUBLIC\n  PRIVATE\n}\n\nUtilisateur ..&gt; UserRole\nCV          ..&gt; CVStatus\nCV          ..&gt; CVSource\nJobOffer    ..&gt; OfferStatus\nResultat    ..&gt; Decision\nCompetence  ..&gt; SkillLevel\nCandidate   ..&gt; VisibilityStatus\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_ssNLDGc8ujyndSEy5ct-56">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
                        <mxGeometry x="-20" y="1070" width="1619" height="1949" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 01_Classes_ATS_RANDA\nskinparam classAttributeIconSize 0\nskinparam classFontSize 11\nskinparam classFontName Arial\nskinparam classBackgroundColor #FEFECE\nskinparam classBorderColor #A80036\nskinparam arrowColor #A80036\nskinparam packageBackgroundColor #EEEEEE\nhide empty methods\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; FILIALE\n&#39; ─────────────────────────────────────────────────────────────\nclass Filiale {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom_filiale : String\n  +adresse : Text\n  +ville : String\n  +created_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; UTILISATEUR — table \&quot;users\&quot; (rôle discriminé par UserRole)\n&#39; ─────────────────────────────────────────────────────────────\nabstract class Utilisateur {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom : String\n  +prenom : String\n  +email : String &lt;&lt;UNIQUE&gt;&gt;\n  +hashed_pwd : String\n  +role : UserRole\n  +departement : String\n  +id_filiale : Integer &lt;&lt;FK&gt;&gt;\n  +is_active : Boolean\n  +google_id : String &lt;&lt;UNIQUE, nullable&gt;&gt;\n  +auth_provider : String\n  +avatar_url : Text\n  +created_at : DateTime\n  +updated_at : DateTime\n}\n\n&#39; ── Spécialisations par rôle (même table, même PK) ──────────\nclass Admin &lt;&lt;role&gt;&gt; {\n  .. Responsabilités ..\n  Gère utilisateurs, filiates,\n  audit logs et santé système\n}\n\nclass Agent &lt;&lt;role&gt;&gt; {\n  .. Responsabilités ..\n  Importe CVs (Keejob / upload),\n  gère les candidats de son portefeuille\n}\n\nclass RH &lt;&lt;role&gt;&gt; {\n  .. Responsabilités ..\n  Publie offres, déclenche le matching,\n  planifie les entretiens via n8n\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; CANDIDATE — table \&quot;candidates\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass Candidate {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +nom : String\n  +prenom : String\n  +email : String &lt;&lt;UNIQUE&gt;&gt;\n  +telephone : String\n  +adresse : Text\n  +date_naissance : String\n  +age : Integer\n  +titre_poste : String\n  +niveau_experience : String\n  +niveau_etude : String\n  +salaire_actuel : String\n  +disponibilite : String\n  +genre : String\n  +situation_familiale : String\n  +nationalite : String\n  +has_driving_license : Boolean\n  +owns_car : Boolean\n  +has_handicap : Boolean\n  +visibility_status : VisibilityStatus\n  +alert_frequency : AlertFrequency\n  +code_postal : String\n  +ville : String\n  +region : String\n  +mobilite_tn : Boolean\n  +mobilite_intl : Boolean\n  +statut_pro : String\n  +secteurs_recherche : JSONB\n  +metiers_recherche : JSONB\n  +created_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; CV — table \&quot;cvs\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass CV {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +id_agent : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +date_depot : DateTime\n  +statut : CVStatus\n  +source : CVSource\n  +fichier_pdf : String\n  +cv_text : Text\n  +cv_entities : JSONB\n  +embedding : Vector(384)\n  +score_final : Float\n  +cv_version : Integer\n  +created_at : DateTime\n  +updated_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; COMPETENCE — table \&quot;competences\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass Competence {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +nom_competence : String\n  +niveau : SkillLevel\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; EXPERIENCE — table \&quot;experiences\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass Experience {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +poste : String\n  +entreprise : String\n  +date_debut : String\n  +date_fin : String\n  +description : Text\n  +type_contrat : String\n  +taille_entreprise : String\n  +categorie_entreprise : String\n  +secteur_activite : String\n  +missions : Text\n  +is_current : Boolean\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; JOBOFFER — table \&quot;job_offers\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass JobOffer {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_rh : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +titre : String\n  +description : Text\n  +competences_requises : JSONB\n  +experience_requise : Float\n  +langue_requise : String\n  +date_publication : DateTime\n  +plateforme_source : String\n  +embedding : Vector(384)\n  +statut : OfferStatus\n  +seuil_alerte : Integer\n  +matching_auto : Boolean\n  +alerte_envoyee : Boolean\n  +details : JSONB\n  +poids_semantique : Float (0.40)\n  +poids_competences : Float (0.35)\n  +poids_experience : Float (0.15)\n  +poids_langue : Float (0.10)\n  +date_expiration : DateTime\n  +raison_refus : Text\n  +date_mise_en_ligne : DateTime\n  +last_matching_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; RESULTAT — table \&quot;resultats\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass Resultat {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_cv : Integer &lt;&lt;FK&gt;&gt;\n  +id_offre : Integer &lt;&lt;FK&gt;&gt;\n  +score_matching : Float\n  +score_skills : Float\n  +score_experience : Float\n  +score_langue : Float\n  +score_final : Float\n  +rang : Integer\n  +decision : Decision\n  +date_analyse : DateTime\n  +last_score_updated_at : DateTime\n  +feedback_rh : Text &lt;&lt;nullable&gt;&gt;\n  +feedback_visible : Boolean\n  +date_decision : DateTime &lt;&lt;nullable&gt;&gt;\n}\n\nnote right of Resultat\n  **Règle métier critique :**\n  RETAINED et REFUSED sont immuables.\n  Seuls les résultats PENDING peuvent\n  être recalculés ou écrasés.\nend note\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; ENTRETIEN — table \&quot;entretiens\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass Entretien {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_resultat : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +id_offre : Integer &lt;&lt;FK&gt;&gt;\n  +id_rh : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +id_candidate_user : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +date_entretien : DateTime\n  +duree_minutes : Integer\n  +lieu : String\n  +type_entretien : String\n  +lien_visio : Text\n  +notes_rh : Text\n  +statut : String\n  +email_envoye : Boolean\n  +email_candidat_envoye : Boolean\n  +n8n_execution_id : String\n  +created_at : DateTime\n  +updated_at : DateTime\n}\n\nnote right of Entretien\n  statut : PROPOSE → CONFIRME\n         → ENVOYE | ANNULE | PLANIFIE\nend note\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; AUDITLOG — table \&quot;audit_logs\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass AuditLog {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +user_id : Integer &lt;&lt;FK, nullable&gt;&gt;\n  +action : String &lt;&lt;INDEX&gt;&gt;\n  +resource : String\n  +resource_id : Integer\n  +details : JSONB\n  +ip_address : String\n  +created_at : DateTime &lt;&lt;INDEX&gt;&gt;\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; COVERLETTER — table \&quot;cover_letters\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass CoverLetter {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +titre : String\n  +contenu : Text\n  +created_at : DateTime\n  +updated_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; CANDIDATEDOCUMENT — table \&quot;candidate_documents\&quot;\n&#39; ─────────────────────────────────────────────────────────────\nclass CandidateDocument {\n  +id : Integer &lt;&lt;PK&gt;&gt;\n  +id_candidate : Integer &lt;&lt;FK&gt;&gt;\n  +nom : String\n  +fichier : String\n  +type_doc : String\n  +taille : Integer\n  +created_at : DateTime\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; ENUMS\n&#39; ─────────────────────────────────────────────────────────────\nenum UserRole {\n  VISITOR\n  CANDIDATE\n  AGENT\n  RH\n  ADMIN\n}\n\nenum CVStatus {\n  UPLOADED\n  PARSING\n  INDEXED\n  ERROR\n}\n\nenum CVSource {\n  KEEJOB\n  AGENT\n  CANDIDAT\n  EMAIL\n  LINKEDIN\n}\n\nenum OfferStatus {\n  ACTIVE\n  INACTIVE\n  ARCHIVED\n  BROUILLON\n  EN_VALIDATION\n  PROCHAINEMENT\n  DESACTIVEE\n  EXPIREE\n  REFUSEE\n}\n\nenum Decision {\n  RETAINED\n  PENDING\n  REFUSED\n}\n\nenum SkillLevel {\n  BEGINNER\n  INTERMEDIATE\n  EXPERT\n}\n\nenum VisibilityStatus {\n  VISIBLE\n  ANONYMOUS\n  INVISIBLE\n}\n\nenum AlertFrequency {\n  DAILY\n  TWICE_WEEK\n  WEEKLY\n  NEVER\n}\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; HÉRITAGE — même table \&quot;users\&quot;, discriminé par role\n&#39; ─────────────────────────────────────────────────────────────\nUtilisateur &lt;|-- Admin\nUtilisateur &lt;|-- Agent\nUtilisateur &lt;|-- RH\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; ASSOCIATIONS\n&#39; ─────────────────────────────────────────────────────────────\nFiliale        \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Utilisateur       : emploie &gt;\n\nAdmin          \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Utilisateur       : gère &gt;\nAdmin          \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Filiale           : gère &gt;\nAdmin          \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog          : consulte &gt;\n\nAgent          \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CV                : téléverse (id_agent)\n\nRH             \&quot;1\&quot; --&gt; \&quot;0..*\&quot; JobOffer          : publie (id_rh)\nRH             \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Entretien         : planifie (id_rh)\n\nCandidate      \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CV                : possède (id_candidate)\nCandidate      \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CoverLetter       : id_candidate\nCandidate      \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CandidateDocument : id_candidate\n\nCV             \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Competence        : id_cv\nCV             \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Experience        : id_cv\nCV             \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Resultat          : id_cv\n\nJobOffer       \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Resultat          : id_offre\nJobOffer       \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Entretien         : id_offre\n\nResultat       \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Entretien         : id_resultat\n\nUtilisateur    \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog          : user_id\n\nEntretien      \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Utilisateur       : id_candidate_user\n\n&#39; ─────────────────────────────────────────────────────────────\n&#39; USAGES ENUM\n&#39; ─────────────────────────────────────────────────────────────\nUtilisateur    ..&gt; UserRole\nCV             ..&gt; CVStatus\nCV             ..&gt; CVSource\nJobOffer       ..&gt; OfferStatus\nResultat       ..&gt; Decision\nCompetence     ..&gt; SkillLevel\nCandidate      ..&gt; VisibilityStatus\nCandidate      ..&gt; AlertFrequency\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="_ssNLDGc8ujyndSEy5ct-57">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
                        <mxGeometry x="-450" y="4700" width="2332" height="2462" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
