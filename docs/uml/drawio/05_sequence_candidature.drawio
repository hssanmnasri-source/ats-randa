        <mxCell id="30" value="Clique sur une candidature (ApplicationsPage)" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="110" as="sourcePoint"/><mxPoint x="255" y="110" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="31" value="GET /api/candidate/applications" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="145" as="sourcePoint"/><mxPoint x="435" y="145" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="32" value="SELECT resultats JOIN job_offers WHERE id_cv IN (SELECT id FROM cvs WHERE id_candidate=?)" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="180" as="sourcePoint"/><mxPoint x="615" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="33" value="[Resultat + JobOffer]" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="215" as="sourcePoint"/><mxPoint x="435" y="215" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="34" value="Liste des candidatures avec scores" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="250" as="sourcePoint"/><mxPoint x="255" y="250" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="35" value="Clique &quot;Voir détail&quot; → Drawer Ant Design" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="290" as="sourcePoint"/><mxPoint x="255" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="36" value="GET /api/candidate/applications/{result_id}/detail" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="325" as="sourcePoint"/><mxPoint x="435" y="325" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="37" value="SELECT resultat JOIN job_offers JOIN cvs WHERE resultat.id=result_id" style="endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="360" as="sourcePoint"/><mxPoint x="615" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="38" value="Resultat complet" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="395" as="sourcePoint"/><mxPoint x="435" y="395" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Timeline steps notes -->
        <mxCell id="39" value="Étape 1 — POSTULÉ: done=true (Resultat existe) | date = resultat.date_analyse&#xa;Étape 2 — ANALYSE IA: done = (cv.statut == INDEXED) | date = cv.updated_at si INDEXED&#xa;Étape 3 — EN EXAMEN: done = (last_score_updated_at &gt; date_analyse)&#xa;Étape 4 — DÉCISION: done = (decision != PENDING) | date = resultat.date_decision&#xa;feedback_rh visible si feedback_visible=true" style="shape=note;whiteSpace=wrap;html=1;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="435" y="420" width="360" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="HTTP 200 {score_final, decision, date_decision, feedback_rh (si visible), timeline: [4 étapes]}" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="545" as="sourcePoint"/><mxPoint x="255" y="545" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="41" value="Affiche timeline + scores détaillés" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="580" as="sourcePoint"/><mxPoint x="75" y="580" as="targetPoint"/></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

