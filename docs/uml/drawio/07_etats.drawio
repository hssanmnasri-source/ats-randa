          <mxGeometry x="200" y="10" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Initial -->
        <mxCell id="3" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- UPLOADED -->
        <mxCell id="4" value="UPLOADED&#xa;Stockage initial&#xa;Fichier dans /app/uploads/cvs/" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- PARSING -->
        <mxCell id="5" value="PARSING&#xa;Traitement Celery en cours&#xa;process_cv_on_upload(cv_id)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- INDEXED -->
        <mxCell id="6" value="INDEXED&#xa;embedding ≠ NULL&#xa;Participe au matching pgvector" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="430" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- ERROR -->
        <mxCell id="7" value="ERROR&#xa;Ne participe pas au matching&#xa;PDF corrompu / texte vide" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="650" y="350" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Initial → UPLOADED -->
        <mxCell id="10" value="Upload fichier&#xa;(POST /api/candidate/cvs/upload&#xa;ou /api/agent/import/keejob)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UPLOADED → PARSING -->
        <mxCell id="11" value="Celery task démarrée&#xa;process_cv_on_upload(cv_id)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" source="4" target="5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PARSING → INDEXED -->
        <mxCell id="12" value="Succès pipeline NLP:&#xa;1. Texte extrait (OCR/pdfplumber)&#xa;2. Entités parsées&#xa;3. Embedding Vector(384) généré&#xa;4. cv_version incrémenté" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" source="5" target="6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PARSING → ERROR -->
        <mxCell id="13" value="Échec irrémédiable&#xa;(max_retries=3)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;" edge="1" source="5" target="7" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- INDEXED → INDEXED (re-embedding) -->
        <mxCell id="14" value="Re-embedding&#xa;PUT /api/candidate/cvs/:id/validate&#xa;(cv_version incrémenté)" style="endArrow=block;endFill=1;curved=1;" edge="1" source="6" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="465"/>
              <mxPoint x="250" y="465"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ERROR → UPLOADED (retry) -->
        <mxCell id="15" value="Import manuel corrigé&#xa;ou re-soumission candidat" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="7" target="4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

