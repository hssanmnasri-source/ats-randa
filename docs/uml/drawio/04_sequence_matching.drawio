                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="605" y="315" as="sourcePoint"/>
                        <mxPoint x="685" y="315" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="37" value="[(cv_id, cosine_sim) × 200]" style="endArrow=open;endFill=0;dashed=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="605" y="350" as="sourcePoint"/>
                        <mxPoint x="420" y="350" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="38" value="=== Scoring multi-critères sur les 200 CVs ===" style="shape=note;whiteSpace=wrap;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="380" y="365" width="380" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="[loop] Pour chacun des 200 CVs: compute_final_score()" style="endArrow=block;endFill=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="420" y="415" as="sourcePoint"/>
                        <mxPoint x="780" y="415" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="40" value="s_sem=cosine_sim | s_comp=Jaccard | s_exp=ratio | s_lang=binary&#xa;final = s_sem×0.40 + s_comp×0.35 + s_exp×0.15 + s_lang×0.10" style="endArrow=block;endFill=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
