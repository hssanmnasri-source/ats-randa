{
  "title": "ATS RANDA — Monitoring",
  "uid": "ats-randa-main",
  "version": 3,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["ats", "randa", "fastapi"],
  "panels": [

    {
      "id": 100,
      "title": "🌐 Backend — API",
      "type": "row",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 1,
      "title": "🌐 Requêtes API / seconde",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 2,
      "title": "⚡ Latence P95 (ms)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "❌ Taux d'erreur 5xx",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100",
          "legendFormat": "Error rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "title": "📊 Requêtes par endpoint (top 10)",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (handler) (rate(http_requests_total[5m])))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "🔄 Requêtes en cours",
      "type": "stat",
      "gridPos": { "x": 12, "y": 9, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(http_requests_in_progress)",
          "legendFormat": "En cours",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "title": "✅ Uptime backend",
      "type": "stat",
      "gridPos": { "x": 16, "y": 9, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },

    {
      "id": 19,
      "title": "💻 CPU backend (%)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 9, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },

    {
      "id": 7,
      "title": "🧠 Mémoire backend (RSS)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RAM Backend (MB)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "megabytes",
          "color": { "mode": "fixed", "fixedColor": "#8B1A1A" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      }
    },

    {
      "id": 8,
      "title": "⏱️ Latence P50 / P95 par méthode HTTP",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (method, le) (rate(http_request_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "P50 {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(http_request_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "P95 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },

    {
      "id": 9,
      "title": "🥧 Distribution codes HTTP",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status_code) (increase(http_requests_total[1h]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 101,
      "title": "🗄️ Redis",
      "type": "row",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 10,
      "title": "📦 Redis — Mémoire utilisée",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 26, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "RAM utilisée",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max configuré",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 11,
      "title": "🔗 Redis — Clients connectés",
      "type": "stat",
      "gridPos": { "x": 8, "y": 26, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Clients",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },

    {
      "id": 12,
      "title": "⚡ Redis — Commandes / sec",
      "type": "stat",
      "gridPos": { "x": 8, "y": 30, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "Cmds/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },

    {
      "id": 20,
      "title": "📊 Redis — Opérations par commande",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(5, rate(redis_command_call_duration_seconds_count[1m]))",
          "legendFormat": "{{cmd}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 1 }
        }
      }
    },

    {
      "id": 102,
      "title": "🐘 PostgreSQL",
      "type": "row",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 13,
      "title": "🗄️ PostgreSQL — Taille base de données",
      "type": "stat",
      "gridPos": { "x": 0, "y": 35, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"ats_db\"}",
          "legendFormat": "Taille ats_db",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "#C9A84C" }
        }
      }
    },

    {
      "id": 21,
      "title": "📋 PostgreSQL — Tables (lignes)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 35, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_live_tup{relname=\"cvs\"}",
          "legendFormat": "CVs",
          "refId": "A"
        },
        {
          "expr": "pg_stat_user_tables_n_live_tup{relname=\"candidates\"}",
          "legendFormat": "Candidats",
          "refId": "B"
        },
        {
          "expr": "pg_stat_user_tables_n_live_tup{relname=\"job_offers\"}",
          "legendFormat": "Offres",
          "refId": "C"
        },
        {
          "expr": "pg_stat_user_tables_n_live_tup{relname=\"resultats\"}",
          "legendFormat": "Résultats",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },

    {
      "id": 14,
      "title": "🔌 PostgreSQL — Connexions actives",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 35, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"ats_db\"}",
          "legendFormat": "Connexions actives",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },

    {
      "id": 15,
      "title": "📈 PostgreSQL — Transactions / sec",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 35, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit_total{datname=\"ats_db\"}[1m])",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback_total{datname=\"ats_db\"}[1m])",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },

    {
      "id": 22,
      "title": "🔎 PostgreSQL — Cache hit ratio",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 39, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"ats_db\"} / (pg_stat_database_blks_hit{datname=\"ats_db\"} + pg_stat_database_blks_read{datname=\"ats_db\"} + 1) * 100",
          "legendFormat": "Cache hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },

    {
      "id": 23,
      "title": "⚠️ PostgreSQL — Deadlocks / sec",
      "type": "stat",
      "gridPos": { "x": 6, "y": 39, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_deadlocks_total{datname=\"ats_db\"}[1m])",
          "legendFormat": "Deadlocks/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },

    {
      "id": 103,
      "title": "🌸 Celery Workers",
      "type": "row",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 16,
      "title": "🌸 Celery — Workers Online",
      "type": "stat",
      "gridPos": { "x": 0, "y": 44, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "flower_workers_online_total",
          "legendFormat": "Workers online",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 17,
      "title": "🌸 Celery — Tâches actives",
      "type": "stat",
      "gridPos": { "x": 6, "y": 44, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(flower_tasks_active)",
          "legendFormat": "Actives",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      }
    },

    {
      "id": 24,
      "title": "🌸 Celery — Tâches succeédées (total)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 44, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(flower_tasks_succeeded_total)",
          "legendFormat": "Réussies",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },

    {
      "id": 25,
      "title": "🌸 Celery — Tâches échouées (total)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 44, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(flower_tasks_failed_total)",
          "legendFormat": "Échouées",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 18,
      "title": "🌸 Celery — Tâches échouées / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(flower_tasks_failed_total[5m])",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2 }
        }
      }
    },

    {
      "id": 26,
      "title": "🌸 Celery — Débit tâches / sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 48, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(flower_tasks_succeeded_total[1m])",
          "legendFormat": "Réussies/sec {{task}}",
          "refId": "A"
        },
        {
          "expr": "rate(flower_tasks_failed_total[1m])",
          "legendFormat": "Échouées/sec {{task}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      }
    }

  ]
}
